{
  "name": "sev1-production-support-sim",
  "version": "1.0.0",
  "description": "A Linux terminal simulator for front-office production support training: real incidents, real commands, real root causes.",
  "private": true,
  "scripts": {
    "start": "node serve.js",
    "test": "node test/run.js",
    "test:engine": "node test/engine.test.js",
    "test:browser": "node test/browser.test.js",
    "test:drills": "node test/drills.test.js",
    "test:accuracy": "node test/shell-accuracy.test.js && node test/system-accuracy.test.js",
    "test:incidents": "node test/incidents.test.js",
    "test:fix": "node test/fix-incidents.test.js",
    "test:platform": "node test/distributed-platform.test.js",
    "test:vocab": "node test/vocab.test.js"
  },
  "keywords": [
    "linux",
    "production-support",
    "sre",
    "training",
    "simulator",
    "fix-protocol",
    "jvm"
  ],
  "license": "MIT"
}
